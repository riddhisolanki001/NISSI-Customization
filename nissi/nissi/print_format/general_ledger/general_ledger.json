 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n        font-size: 11px;\n    }\n\n    .print-format td,\n    .print-format th {\n        padding: 4px !important;\n        vertical-align: top;\n    }\n\n    .text-right {\n        text-align: right;\n    }\n\n    .text-center {\n        text-align: center;\n    }\n\n    .bold {\n        font-weight: bold;\n    }\n\n    .border-top {\n        border-top: 1px solid #000;\n    }\n\n    .border-bottom {\n        border-bottom: 1px solid #000;\n    }\n\n    .grey-row {\n        background-color: #dedede;\n    }\n\n    .header-title {\n        text-align: center;\n        font-size: 16px;\n        font-weight: bold;\n    }\n\n    thead {\n        display: table-header-group;\n    }\n\n    tfoot {\n        display: table-footer-group;\n    }\n\n    tr {\n        page-break-inside: avoid;\n    }\n\n</style>\n\n{%\n\n    function fmt_money(v) {\n\n        v = v || 0;\n\n        if (v < 0) {\n\n            return \"(\" +\n                format_currency(Math.abs(v), \"GHS\")\n                    .replace(\"GHS\", \"\")\n                    .trim()\n            + \")\";\n\n        }\n\n        return format_currency(v, \"GHS\")\n            .replace(\"GHS\", \"\")\n            .trim();\n    }\n\n    function fmt_date(d) {\n    \n        if (!d) return \"\";\n    \n        return frappe.datetime.str_to_user(d).replace(\n            /(\\d{2})-(\\d{2})-(\\d{4})/,\n            function(match, day, month, year) {\n    \n                var months = [\n                    \"Jan\", \"Feb\", \"Mar\", \"Apr\",\n                    \"May\", \"Jun\", \"Jul\", \"Aug\",\n                    \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n                ];\n    \n                return day + \" \" + months[parseInt(month) - 1] + \" \" + year;\n            }\n        );\n    }\n    \n    function safe(v) {\n\n        return v || \"\";\n    }\n\n\n%}\n\n\n<!-- ===================================================== -->\n<!-- REPEATING PDF HEADER -->\n<!-- ===================================================== -->\n\n<div id=\"header-html\" class=\"hidden-pdf\">\n\n    <!-- TITLE + DATE TABLE - 3 COLUMN STRUCTURE -->\n\n<table style=\"margin-top:-10px; table-layout:fixed; width:100%; border-bottom:1px solid #000; margin-bottom:10px;\">\n    \n    <!-- TITLE + FROM ROW -->\n    <tr>\n        <!-- COLUMN 1: EMPTY -->\n        <td style=\"width:25%; vertical-align:middle;\"></td>\n        \n        <!-- COLUMN 2: TITLE - CENTER ALIGNED -->\n        <td style=\"width:50%; vertical-align:middle; text-align:center; font-weight:bold; font-size:16px;\">\n            \n            {% \n        \n                var has_account =\n                    filters.account &&\n                    (\n                        (Array.isArray(filters.account) && filters.account.length > 0)\n                        ||\n                        (!Array.isArray(filters.account) && filters.account !== \"\")\n                    );\n                \n                var title_text = \"\";\n                \n                if(has_account) {\n                    title_text = \"ACCOUNT LEDGER STATEMENT\";\n                } else if(filters.party_type === \"Supplier\") {\n                    title_text = \"SUPPLIER LEDGER STATEMENT\";\n                } else if(filters.party_type === \"Customer\") {\n                    title_text = \"CUSTOMER STATEMENT\";\n                } else {\n                    title_text = \"LEDGER STATEMENT\";\n                }\n\n            %}\n            \n            {%= title_text %}\n            \n        </td>\n        \n        <!-- COLUMN 3: FROM DATE -->\n        <td style=\"width:25%; vertical-align:middle; text-align:right; font-size:12px;\">\n            <b>From</b> : {%= fmt_date(filters.from_date || \"\") %}\n        </td>\n    </tr>\n    \n    <!-- TO DATE ROW -->\n    <tr>\n        <!-- COLUMN 1: EMPTY -->\n        <td style=\"width:25%;\"></td>\n        \n        <!-- COLUMN 2: EMPTY -->\n        <td style=\"width:50%;\"></td>\n        \n        <!-- COLUMN 3: TO DATE -->\n        <td style=\"width:25%; text-align:right; font-size:12px;\">\n            <b>To</b> : {%= fmt_date(filters.to_date || \"\") %}\n        </td>\n    </tr>\n</table>\n\n<!-- ID + NAME + ADDRESS TABLE - 3 COLUMN STRUCTURE -->\n\n<table style=\"margin-top:-5px; width:100%; font-size:11px; table-layout: fixed;\">\n    \n    <!-- ID LABEL : ID VALUE ROW -->\n    <tr>\n        <!-- COLUMN 1: ID LABEL + VALUE -->\n        <td style=\"width:25%; text-align:left; vertical-align:top;\">\n            <b>ID:</b> \n            {%\n        \n                var party_code = \"\";\n                var party_name = \"\";\n        \n                var account = \"\";\n        \n                if (\n                    filters.account &&\n                    (\n                        (Array.isArray(filters.account) && filters.account.length > 0)\n                        ||\n                        (!Array.isArray(filters.account) && filters.account !== \"\")\n                    )\n                ) {\n        \n                    account = Array.isArray(filters.account)\n                        ? filters.account[0]\n                        : filters.account;\n        \n                }\n        \n        \n                if (account && account.indexOf(\" \") !== -1) {\n        \n                    var parts = account.split(' ');\n        \n                    if (/^\\d+$/.test(parts[0])) {\n        \n                        party_code = parts[0];\n                        party_name = parts.slice(1).join(' ');\n        \n                    } else {\n        \n                        party_code = \"\";\n                        party_name = account;\n        \n                    }\n        \n                } else {\n        \n                    party_code = \"\";\n                    party_name = account || \"\";\n        \n                }\n        \n            %}\n        \n            {%= safe(party_code) %}\n        </td>\n        \n        <!-- COLUMN 2: NAME LABEL + VALUE -->\n        <td style=\"width:50%; text-align:center; vertical-align:top;\">\n            <b>Name:</b> \n            {%\n        \n                var has_account =\n                    filters.account &&\n                    (\n                        (Array.isArray(filters.account) && filters.account.length > 0)\n                        ||\n                        (!Array.isArray(filters.account) && filters.account !== \"\")\n                    );\n        \n            %}\n        \n            {% if(has_account) { %}\n        \n                {% if(Array.isArray(filters.account)) { %}\n        \n                    {% for(var i = 0; i < filters.account.length; i++) { %}\n                            {%= filters.account[i] %}\n                    {% } %}\n        \n                {% } else { %}\n        \n                    {%= filters.account %}\n        \n                {% } %}\n        \n            {% } else { %}\n        \n                {%= safe(filters.party || \"\") %}\n        \n            {% } %}\n        </td>\n        \n        <!-- COLUMN 3: EMPTY -->\n        <td style=\"width:25%;\"></td>\n    </tr>\n    \n    <!-- ADDRESS LABEL : ADDRESS VALUE ROW -->\n    <tr>\n        <!-- COLUMN 1: ADDRESS LABEL + VALUE -->\n        <td style=\"width:25%; text-align:left; vertical-align:top;\">\n            <b>Address:</b>\n        </td>\n        \n        <!-- COLUMN 2: ADDRESS VALUE -->\n        <td style=\"width:50%; text-align:left; vertical-align:top;\">\n            {%= safe(filters.address || \"\") %}\n        </td>\n        \n        <!-- COLUMN 3: EMPTY -->\n        <td style=\"width:25%;\"></td>\n    </tr>\n</table>\n\n</div>\n<!-- ===================================================== -->\n<!-- REPORT TABLE -->\n<!-- ===================================================== -->\n\n<table style=\"margin-top:10px;\">\n\n    <thead>\n\n        <tr class=\"border-top border-bottom\">\n\n            <th width=\"15%\">\n                Date\n            </th>\n\n            <th width=\"20%\">\n                Doc. Number\n            </th>\n\n            <th width=\"12%\">\n                Narration\n            </th>\n\n            <th width=\"10%\">\n                Cheque No\n            </th>\n\n            <th width=\"15%\">\n                Mode Of Payment\n            </th>\n\n            <th width=\"9%\" class=\"text-right\">\n                Debit\n            </th>\n\n            <th width=\"9%\" class=\"text-right\">\n                Credit\n            </th>\n\n            <th width=\"10%\" class=\"text-right\">\n                Balance\n            </th>\n\n        </tr>\n\n    </thead>\n\n   <tbody>\n\n   {%\n   \n    var total_debit = 0;\n    var total_credit = 0;\n    var closing_balance = 0;\n    var opening_balance = 0;\n    var has_transactions = false;\n\n\n        for(var j = 0; j < data.length; j++) {\n            if(!data[j].posting_date) {\n                opening_balance = flt(data[j].balance || 0); \n                break;\n            }\n        }\n    %}\n\n    <!-- OPENING BALANCE ROW -->\n    <tr>\n        <td colspan=\"7\">\n            Balance Brought Forward\n        </td>\n        <td class=\"text-right\">\n            {%= fmt_money(opening_balance) %}\n        </td>\n    </tr>\n\n\n    {% for(var i = 0; i < data.length; i++) { %}\n\n        {% var row = data[i]; %}\n\n        {% if(row.posting_date) { %}\n\n            {%\n                has_transactions = true;\n                total_debit += flt(row.debit || 0);\n                total_credit += flt(row.credit || 0);\n                closing_balance = flt(row.balance || 0);\n            %}\n\n            <tr class=\"{%= i % 2 ? 'grey-row' : '' %}\">\n\n                <td>\n                    {%= fmt_date(row.posting_date) %}\n                </td>\n\n                <td>\n                    {%= safe(row.voucher_no) %}\n                </td>\n\n                <td>\n                    {%= safe(row.voucher_subtype || \"\") %}\n                </td>\n\n                <td>\n                    {%= safe(row.reference_no || \"\") %}\n                </td>\n\n                <td>\n                    {%= safe(row.mode_of_payment || \"\") %}\n                </td>\n\n                <td class=\"text-right\">\n                    {%= fmt_money(row.debit || 0) %}\n                </td>\n\n                <td class=\"text-right\">\n                    {%= fmt_money(row.credit || 0) %}\n                </td>\n\n                <td class=\"text-right\">\n                    {%= fmt_money(row.balance || 0) %}\n                </td>\n\n            </tr>\n\n        {% } %}\n\n    {% } %}\n\n    <tr class=\"border-top\">\n\n        <td colspan=\"5\"></td>\n\n        <td class=\"text-right bold\">\n\n            {%= fmt_money(total_debit) %}\n\n        </td>\n\n        <td class=\"text-right bold\">\n\n            {%= fmt_money(total_credit) %}\n\n        </td>\n\n        <td></td>\n\n    </tr>\n\n    <tr>\n\n        <td colspan=\"6\"></td>\n\n        <td class=\"text-right bold\">\n\n            Balance:\n\n        </td>\n\n        <td class=\"text-right bold\">\n\n             {%= fmt_money(has_transactions ? closing_balance : opening_balance) %}\n\n        </td>\n\n    </tr>\n\n</tbody>\n\n</table>\n\n<table style=\"margin-top:10px; width:100%;\">\n\n    <tr>\n\n        <td style=\"width:12%;\">\n\n            <b>Generated By:</b>\n\n        </td>\n\n        <td style=\"width:88%;\">\n\n            <span style=\"\n                border-bottom:1px dotted #000;\n                display:inline-block;\n                padding:0 30px 2px 30px;\n                text-align:center;\n            \">\n\n                {%= frappe.session.user %}\n\n            </span>\n\n        </td>\n\n    </tr>\n\n</table>\n\n<!-- ===================================================== -->\n<!-- REPEATING PDF FOOTER -->\n<!-- ===================================================== -->\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n\n    <div style=\"\n        font-size:10px;\n        color:#777;\n        width:100%;\n    \">\n\n        Printed on:\n        {%= frappe.datetime.now_datetime() %}\n\n    </div>\n\n</div>",
